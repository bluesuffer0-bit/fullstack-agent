<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain form. TextInputLayout carries the hint and the error styling so
  the field explains itself; the switches are the installed set, which is
  what decides which buttons the main screen shows.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/settings_name_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_home_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_home"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_command_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/settings_face_hint">

            <AutoCompleteTextView
                android:id="@+id/edit_face"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_installed"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_memory"
            android:paddingVertical="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_face"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_face_switch"
            android:paddingVertical="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_hands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_hands"
            android:paddingVertical="8dp" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_voice"
            android:paddingVertical="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/settings_save" />

    </LinearLayout>
</ScrollView>
