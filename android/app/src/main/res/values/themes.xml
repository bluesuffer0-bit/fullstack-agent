<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Material Components is the parent (not Material3) because the
         offline cache carries material 1.9.0 and its M2 widget set, and
         because the app uses no Compose. DayNight so the launcher reads
         in the dark of a room, which is where a talking agent tends to
         be used. -->
    <style name="Theme.FullstackAgent" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/primary_dark</item>
    </style>

    <!-- One button family, three weights. The primary action is Talk;
         everything else is a step down in emphasis, and the settings
         entry is text-only so it never competes with the agent itself. -->
    <style name="Widget.FullstackAgent.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">14dp</item>
    </style>

    <style name="Widget.FullstackAgent.Button.Primary">
        <item name="android:textSize">17sp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">18dp</item>
    </style>

    <style name="Widget.FullstackAgent.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">14dp</item>
    </style>

    <style name="Widget.FullstackAgent.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">14dp</item>
    </style>

</resources>
